# Copy this file to jenkins/.env and replace every placeholder with a local
# runtime value. Never commit the resulting .env file.
JENKINS_ADMIN_ID=replace-with-local-admin-id
JENKINS_ADMIN_PASSWORD=replace-with-local-admin-password
JENKINS_GITHUB_USERNAME=replace-with-github-username
JENKINS_GITHUB_TOKEN=replace-with-fine-grained-github-token
ARTIFACT_REGISTRY_PUBLISHER_KEY_BASE64=replace-with-base64-encoded-service-account-json
JENKINS_BUILD_AGENT_SECRET=replace-with-build-test-agent-secret
JENKINS_DOCKER_AGENT_SECRET=replace-with-docker-agent-secret
JENKINS_WEBHOOK_RELAY_URL=https://smee.io/replace-with-local-channel-id
